# ==========================================
# RAG Chatbot Pipeline Configuration (.env)
# ==========================================

# Vector Store Setting ('chroma' or 'faiss')
VECTOR_STORE_TYPE=chroma

# Persistent Data Storage Directories
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
FAISS_PERSIST_DIRECTORY=./data/faiss_index

# Embedding Provider: 'local_minilm' (offline, no key needed) or 'openai'
EMBEDDING_PROVIDER=local_minilm

# LLM Provider: 'groq', 'openai', 'ollama', or 'mock'
LLM_PROVIDER=groq

# API Keys (Keep blank in .env.example)
OPENAI_API_KEY=
GROQ_API_KEY=

# Model Names
OPENAI_MODEL_NAME=gpt-4o-mini
GROQ_MODEL_NAME=qwen/qwen3.8-27b
OLLAMA_MODEL_NAME=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Chunking Hyperparameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval Hyperparameters
TOP_K=4
SEARCH_TYPE=similarity
